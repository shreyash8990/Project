<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.AddBookController">
    
    <Label text="📖 Add a New Book" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    
    <TextField fx:id="titleField" promptText="Book Title" maxWidth="250"/>
    <TextField fx:id="authorField" promptText="Author Name" maxWidth="250"/>
    <TextField fx:id="isbnField" promptText="ISBN Number" maxWidth="250"/>
    
    <Button text="Save Book" onAction="#handleSaveBook" prefWidth="150" style="-fx-cursor: hand;"/>
    <Button text="Back to Dashboard" onAction="#handleBackToDashboard" prefWidth="150" style="-fx-cursor: hand;"/>
    
    <Label fx:id="messageLabel" />
</VBox>
