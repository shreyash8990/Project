<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.DashboardController">
    
    <Label text="📚 Library Main Menu" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <Button text="1. Add a New Book" onAction="#handleAddBook" prefWidth="200"/>
    <Button text="2. View All Books" onAction="#handleViewBooks" prefWidth="200"/>
    <Button text="3. Search &amp; Delete Book" onAction="#handleSearchDelete" prefWidth="200"/>
    <Button text="4. Issue Book" onAction="#handleIssueBook" prefWidth="200"/>
    <Button text="5. Return Book" onAction="#handleReturnBook" prefWidth="200"/>
    <Button text="6. Exit System" onAction="#handleExit" prefWidth="200"/>
    
</VBox>


